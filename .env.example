# BantuDulu — Environment Variables (example)
# Copy to .env for local development only. Never commit the real .env file.

APP_ENV=development
ENABLE_DEV_SEED=true
JWT_EXPIRY_HOURS=24

# Generate with:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-long-random-secret

# SQLite development/test only:
# DATABASE_URL=sqlite+aiosqlite:///app/bantudulu_v2.db

# Production contract:
# APP_ENV=production
# ENABLE_DEV_SEED=false
# SECRET_KEY=<minimum 32 chars, random, stored outside git>
# DATABASE_URL=mysql+aiomysql://USER:PASSWORD@HOST:3306/DATABASE
#
# Production explicitly rejects SQLite and development seed.
# Run `python -m scripts.migrate` before starting/restarting the web service.

# Alternative MySQL/MariaDB fields when DATABASE_URL is not provided:
# DB_ENGINE=mysql
# MYSQL_USER=bantudulu_admin
# MYSQL_PASS=replace-with-a-strong-password
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306
# MYSQL_DB=bantudulu_db
