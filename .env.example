# BantuDulu — Environment Variables (example)
# Copy to .env and fill in your values

# 🔑 Security: Generate a random key with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-secret-key-here

# Database: Default SQLite. Uncomment for MySQL:
# DB_ENGINE=mysql
# MYSQL_USER=bantudulu_admin
# MYSQL_PASS=your-password-here
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3307
# MYSQL_DB=bantudulu_db
