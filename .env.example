# BantuDulu environment example — NEVER put real secrets in this file.

APP_ENV=development
SECRET_KEY=change-me-locally
JWT_EXPIRY_HOURS=24
JWT_ISSUER=BantuDulu
JWT_AUDIENCE=bantudulu-web

# Production: set a persistent PostgreSQL/MySQL URL.
# DATABASE_URL=postgresql://user:password@host/database
DATABASE_URL=

# Local convenience. Production should set all three false.
STARTUP_DB_INIT=true
ENABLE_DEMO_SEED=true
ENABLE_CATALOG_SYNC=true

# Enable only after `alembic upgrade head`.
MARKETPLACE_SCHEMA_ENABLED=false

# Google Identity
GOOGLE_CLIENT_ID=

# Cloudflare Turnstile
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Payment methods
PAYMENT_BANK_ENABLED=false
PAYMENT_QRIS_ENABLED=false
